# ──────────────────────────────────────────────────────────────────────────────
# DaySponsor environment variables
#
# Copy this file to `.env.local` and fill in real values.
#
# NEVER commit real credentials. This file holds inert placeholders only — the same
# shape as the real variables, but no secret material. If a value here looks like a
# real key, it is a placeholder and must be rotated.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Public origin of the deployment. Used to build absolute URLs for Stripe
# success/cancel redirects and Connect account links.
# Local dev:  http://localhost:3000
# Preview:    https://<your-preview-domain>.vercel.app
# Production: https://your-domain.com
APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL, safe to expose (it is embedded in the browser client).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Anon public key, safe to expose. RLS restricts what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY
# SERVICE ROLE KEY — full bypass of RLS. Never expose to the browser, never put it
# behind a NEXT_PUBLIC_ prefix. Used only by server routes (webhooks, payouts,
# refunds, cron jobs) and only through `getAdminClient()`.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# ── Stripe ────────────────────────────────────────────────────────────────────
# Restricted secret key from https://dashboard.stripe.com/apikeys
# NEVER prefix with NEXT_PUBLIC_. Server only.
STRIPE_SECRET_KEY=sk_test_YOUR-STRIPE-SECRET-KEY
# Signing secret for the webhook endpoint registered in the Stripe Dashboard
# (or `whsec_...` printed by `stripe listen --forward-to`).
STRIPE_WEBHOOK_SECRET=whsec_YOUR-WEBHOOK-SIGNING-SECRET
# Publishable key, safe to expose (used for client-side Stripe.js if needed).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR-STRIPE-PUBLISHABLE-KEY
# Pinned Stripe API version. Matches the version the code is written and tested
# against; pins behaviour across SDK upgrades. Do not change without a full
# re-test of the payout and refund paths.
STRIPE_API_VERSION=2023-10-16

# ── Auction configuration ────────────────────────────────────────────────────
# Hours a winning brand has to pay after the auction closes before the slot is
# offered to the next bidder.
AUCTION_PAYMENT_DEADLINE_HOURS=24
# How many fallback winners the closing job will try before the slot is marked
# failed and handed to an admin.
AUCTION_MAX_WINNER_ATTEMPTS=5
# Platform fee in basis points (1000 = 10%).
PLATFORM_FEE_BPS=1000
# ISO 4217 lowercase code used for all charges, transfers and refunds.
PLATFORM_CURRENCY=eur

# ── Scheduled jobs (cron) ────────────────────────────────────────────────────
# Shared secret that authorizes the protected /api/cron/* routes. Generate one
# with:  openssl rand -hex 32
# Configure your scheduler to send it as `Authorization: Bearer <CRON_SECRET>`.
# The routes never accept user ids or amounts from request parameters — the
# secret only authorizes a run, it does not parameterize it.
CRON_SECRET=GENERATE-WITH-openssl-rand-hex-32

# ── Email / notifications (optional in dev) ──────────────────────────────────
RESEND_API_KEY=re_YOUR-RESEND-API-KEY
AUTH_SECRET=GENERATE-A-RANDOM-SECRET

# ── Local dev test account (dev only — remove from production env) ──────────
# Convenience credentials for the seeded local admin. Never ship these.
NEXT_PUBLIC_TEST_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_TEST_ADMIN_PASSWORD=CHANGE-ME-DEV-ONLY
